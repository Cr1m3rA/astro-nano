---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import DiaryCard from "@components/DiaryCard.astro";
import YearIcon from "@components/icons/YearIcon.astro";
import MonthIcon from "@components/icons/MonthIcon.astro";
import { DIARY } from "@consts";
import { groupByYearMonth } from "@lib/utils";

const entries = (await getCollection("diary")).filter(
  (item) => !item.data.draft
);
const groups = groupByYearMonth(entries, (item) => item.data.date);
---

<PageLayout title={DIARY.TITLE} description={DIARY.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Diary
      </div>
      <div class="space-y-10">
        {
          groups.map((group) => (
            <section class="animate space-y-5">
              <div class="flex items-center gap-2 font-semibold text-black dark:text-white">
                <YearIcon year={group.year} size={16} />
                <span>{group.year}</span>
              </div>
              <div class="space-y-6">
                {group.months.map((monthGroup) => (
                  <div class="space-y-3">
                    <div class="flex items-center gap-1.5 text-sm">
                      <MonthIcon month={monthGroup.month} size={14} />
                      <span>{monthGroup.month} 月</span>
                    </div>
                    <ul class="flex flex-col gap-4">
                      {monthGroup.entries.map((entry) => (
                        <li>
                          <DiaryCard entry={entry} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
