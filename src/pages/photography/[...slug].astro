---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Byline from "@components/Byline.astro";
import Lightbox from "@components/Lightbox.astro";
import { excerpt } from "@lib/utils";

export async function getStaticPaths() {
  const entries = (await getCollection("photography"))
    .filter((item) => !item.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

type Props = CollectionEntry<"photography">;

const entry = Astro.props;
const { Content } = await entry.render();
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? excerpt(entry.body, 160)}
>
  <Container width="wide">
    <div class="animate">
      <BackToPrev href="/photography">
        Back to photography
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <Byline
        date={entry.data.date}
        dateEnd={entry.data.dateEnd}
        author={entry.data.author}
        body={entry.body}
      />
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {entry.data.title}
      </div>
    </div>
    <article class="prose-gallery animate">
      <Content />
    </article>
  </Container>
  <Lightbox />
</PageLayout>
