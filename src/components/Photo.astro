---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { readPhotoExif } from "@lib/photo";
import { hasExifDetails, type PhotoExif } from "@lib/exif";
import { cn } from "@lib/utils";

type Props = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: "prose" | "wide" | "full";
  align?: "left" | "center" | "right";
  pair?: ImageMetadata | ImageMetadata[];
  exif?: PhotoExif | false;
  shadow?: boolean;
  class?: string;
};

const {
  src,
  alt,
  caption,
  width = "prose",
  align = "center",
  pair,
  exif,
  shadow = true,
  class: className,
} = Astro.props;

const partners = pair ? (Array.isArray(pair) ? pair : [pair]) : [];
const total = 1 + partners.length;

const widthClass = {
  prose: "max-w-prose",
  wide: "max-w-4xl",
  full: "max-w-none",
} as const;

const alignClass = {
  left: "mr-auto",
  center: "mx-auto",
  right: "ml-auto",
} as const;

const detected = exif === false ? undefined : (exif ?? (await readPhotoExif(src.src)));
const showExif = detected && hasExifDetails(detected) ? detected : undefined;

const ratio = src.width / src.height;
const orientation = ratio > 1.05 ? "landscape" : ratio < 0.95 ? "portrait" : "square";

const imageClass =
  orientation === "portrait"
    ? "mx-auto h-auto max-h-[78vh] w-auto"
    : orientation === "square"
      ? "mx-auto h-auto w-full max-w-[min(100%,32rem)]"
      : "h-auto w-full";

const facts = showExif
  ? [
      showExif.camera,
      showExif.lens,
      showExif.focalLength,
      showExif.aperture,
      showExif.shutter,
      showExif.iso,
    ].filter((value): value is string => Boolean(value))
  : [];

const meta = showExif
  ? [showExif.dimensions, showExif.size].filter((value): value is string => Boolean(value))
  : [];
---

<figure class={cn("my-8 space-y-3", widthClass[width], alignClass[align], className)}>
  <div
    class={cn(
      "grid gap-3",
      total === 1 && "grid-cols-1",
      total === 2 && "grid-cols-1 sm:grid-cols-2",
      total >= 3 && "grid-cols-2"
    )}
  >
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1024, 1440]}
      sizes={total === 1 ? "(min-width: 1024px) 720px, 100vw" : "(min-width: 640px) 50vw, 100vw"}
      class={cn("rounded-lg", imageClass, shadow && "photo-surface")}
      loading="lazy"
      decoding="async"
      data-lightbox-source
    />
    {
      partners.map((partner) => (
        <Image
          src={partner}
          alt=""
          widths={[480, 768, 1024]}
          sizes="(min-width: 640px) 50vw, 100vw"
          class={cn("mx-auto h-auto max-h-[62vh] w-auto rounded-lg", shadow && "photo-surface")}
          loading="lazy"
          decoding="async"
          data-lightbox-source
        />
      ))
    }
  </div>

  {
    (caption || facts.length > 0 || meta.length > 0) && (
      <figcaption class="space-y-1 text-sm opacity-75">
        {caption && <p class="text-current">{caption}</p>}
        {facts.length > 0 && (
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs tracking-wide">
            {facts.map((fact, index) => (
              <>
                {index > 0 && (
                  <span aria-hidden="true" class="opacity-40">
                    ·
                  </span>
                )}
                <span>{fact}</span>
              </>
            ))}
          </p>
        )}
        {meta.length > 0 && (
          <p class="flex flex-wrap items-center gap-x-2 text-xs opacity-60">
            {meta.join(" · ")}
          </p>
        )}
      </figcaption>
    )
  }
</figure>
