---
import { SITE } from "@consts";
import { cn } from "@lib/utils";

type Props = {
  size?: number;
  class?: string;
};

const { size = 24, class: className } = Astro.props;
---

<img
  src={SITE.AVATAR}
  alt={SITE.NAME}
  width={size}
  height={size}
  style={`width:${size}px;height:${size}px`}
  class={cn(
    "rounded-full object-cover ring-1 ring-black/10 dark:ring-white/20",
    className
  )}
/>
