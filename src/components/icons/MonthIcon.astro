---
import { getMonthIcon } from "@lib/calendar";
import { cn } from "@lib/utils";

type Props = {
  month: number;
  size?: number;
  class?: string;
};

const { month, size = 14, class: className } = Astro.props;
const Icon = getMonthIcon(month);
---

<Icon
  size={size}
  stroke-width={1.5}
  aria-label={`${month} 月`}
  class={cn("shrink-0", className)}
/>
