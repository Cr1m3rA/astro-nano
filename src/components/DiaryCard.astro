---
import type { CollectionEntry } from "astro:content";
import Globe from "@lucide/astro/icons/globe";
import Lock from "@lucide/astro/icons/lock";
import Arrow from "@components/Arrow.astro";
import { formatFullDate } from "@lib/utils";
import { isDiaryUnlocked } from "@lib/diary";

type Props = {
  entry: CollectionEntry<"diary">;
};

const { entry } = Astro.props;
const unlocked = isDiaryUnlocked(entry.data);
const isPrivate = entry.data.private === true;
---

<a
  href={`/diary/${entry.slug}`}
  class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
>
  <div class="flex flex-col flex-1 truncate">
    <div class="font-semibold">
      {formatFullDate(entry.data.date)}
    </div>
    <div class="text-sm flex items-center gap-1">
      {
        unlocked ? (
          <Globe size={12} stroke-width={1.5} aria-label="公开" />
        ) : (
          <Lock size={12} stroke-width={1.5} aria-label={isPrivate ? "永不公开" : "加密"} />
        )
      }
      <span>{unlocked ? "公开" : isPrivate ? "永不公开" : "加密"}</span>
    </div>
  </div>
  <Arrow />
</a>
